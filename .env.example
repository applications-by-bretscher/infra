# =============================================================================
# Konfiguration des infra-Stacks  →  kopieren nach /srv/infra/.env
#
#   cp /srv/infra/.env.example /srv/infra/.env
#
# Diese Datei enthält Zugangsdaten und gehört NICHT ins Git (siehe .gitignore).
# =============================================================================

# ── MySQL ────────────────────────────────────────────────────────────────────
# Root-Passwort der zentralen Datenbank. Sicher erzeugen:
#   openssl rand -base64 24
MYSQL_ROOT_PASSWORD=CHANGE_ME

# An welche Adresse der MySQL-Port gebunden wird.
#   127.0.0.1  → nur lokal auf argos (Standard, sicher)
#   0.0.0.0    → auch aus dem LAN erreichbar – nur bewusst setzen
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_HOST_PORT=3306

# ── Edge-Router ──────────────────────────────────────────────────────────────
# Port, auf dem Caddy für hades erreichbar ist
EDGE_HTTP_PORT=8080

# ── Whisper ──────────────────────────────────────────────────────────────────
# large-v3 ist am genauesten, braucht aber ~3 GB. Kleinere Alternativen:
# medium, small, base
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
