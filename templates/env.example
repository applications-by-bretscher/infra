# =============================================================================
# VORLAGE – Root-.env (Compose-Variablen, KEINE App-Secrets!)
# Kopieren nach: .env.example im Wurzelverzeichnis der neuen App.
#
# Auf dem Server existiert diese Datei ZWEIMAL, mit unterschiedlichen Werten:
#   /srv/apps/<app>/production/.env
#   /srv/apps/<app>/staging/.env
# Sie ist gitignored und bleibt bei Deploys unangetastet.
# =============================================================================

# ── App-Identität ────────────────────────────────────────────────────────────
# Steuert Compose-Projektname, Image-Namen und Netzwerk-Aliase.
# Nur Kleinbuchstaben/Ziffern/Bindestrich. Muss zum Serververzeichnis
# /srv/apps/<APP_NAME>/ passen. In BEIDEN Umgebungen derselbe Wert.
APP_NAME=meine-app

# ── Deploy-Ziel (pro Umgebung UNTERSCHIEDLICH) ───────────────────────────────
#   production: DOMAIN=meine-app.ch          PUBLIC_API_URL=https://meine-app.ch/api
#   staging:    DOMAIN=staging.meine-app.ch  PUBLIC_API_URL=https://staging.meine-app.ch/api
#
# PUBLIC_API_URL wird zur BUILD-Zeit ins Frontend-Bundle gebacken – immer die
# volle Domain angeben, nicht relativ "/api".
DOMAIN=meine-app.ch
PUBLIC_API_URL=https://meine-app.ch/api

# ── Nur lokal relevant: Dev-Container und Host-Ports ─────────────────────────
# Auf dem Server werden diese nicht gebraucht. Lokal anpassen, falls die Ports
# schon belegt sind (z.B. wenn mehrere Projekte parallel laufen).
# MYSQL_HOST_PORT=3306
# BACKEND_HOST_PORT=3004
# FRONTEND_HOST_PORT=5173
